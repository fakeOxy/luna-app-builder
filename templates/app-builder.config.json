{
  "schemaVersion": 3,
  "appBuilder": {
    "agentName": "Luna",
    "creator": "Massimiliano",
    "version": "2.0.0-beta.1",
    "welcomeShown": false,
    "routing": "autonomous"
  },
  "project": {
    "name": "{PROJECT_NAME}",
    "mode": "{PROJECT_MODE}",
    "origin": "{PROJECT_ORIGIN}",
    "adoptionStatus": "{ADOPTION_STATUS}",
    "platforms": [],
    "stateOwner": "current-session"
  },
  "workflow": {
    "mode": "auto",
    "twoChats": false,
    "designChat": null,
    "developmentChat": null,
    "rule": "single chat by default; split only when design and development have material independent work"
  },
  "bootstrap": {
    "status": "pending",
    "consentRequired": true,
    "automaticAfterConsent": true,
    "registry": ".app-builder/specialists.json",
    "report": ".app-builder/bootstrap-report.md",
    "securityCatalog": {
      "downloadFullCatalog": true,
      "activateOnDemandOnly": true,
      "index": ".app-builder/security-catalog/index.json"
    }
  },
  "routing": {
    "askUserToChooseSkill": false,
    "preserveExistingProject": true,
    "maxConcurrentSlices": 1,
    "continueReversibleStepsAutomatically": true
  },
  "integrations": {
    "expo": "auto",
    "supabase": "auto",
    "codexSecurity": "primary-security-engine",
    "communitySecurityCatalog": "on-demand-playbooks"
  }
}
