{
  "schemaVersion": 2,
  "appBuilder": {
    "agentName": "Luna",
    "creator": "Massimiliano",
    "version": "2.0.0-beta.1",
    "welcomeShown": false
  },
  "project": {
    "name": "{PROJECT_NAME}",
    "mode": "{PROJECT_MODE}",
    "platforms": [],
    "stateOwner": "current-session"
  },
  "workflow": {
    "mode": "auto",
    "twoChats": false,
    "designChat": null,
    "developmentChat": null,
    "rule": "personal=single by default; prototype=conditional; publication=two chats recommended when design and development run separately"
  },
  "integrations": {
    "expo": "auto",
    "supabase": "auto",
    "codexSecurity": "auto"
  }
}
